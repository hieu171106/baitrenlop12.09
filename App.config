<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <add name="MyConnectionString" 
         connectionString="Data Source=.;Initial Catalog=QuanLySachDB;Integrated Security=True;TrustServerCertificate=True;Connect Timeout=5" 
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- Tuỳ chọn: "Auto", "SqlServer", hoặc "Sqlite" -->
    <add key="DatabaseProvider" value="Auto" />
  </appSettings>
</configuration>
